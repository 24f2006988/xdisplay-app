<?xml version="1.0" encoding="utf-8"?>
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
        <!-- Each resolution below specifies 60 Hz; global adds 90/120/144 Hz (4 rates * 25 sizes = 100 modes).
             Keep total modes well below ~200 so Windows IddCxMonitorArrival never fails with STATUS_NOT_SUPPORTED. -->
        <g_refresh_rate>90</g_refresh_rate>
        <g_refresh_rate>120</g_refresh_rate>
        <g_refresh_rate>144</g_refresh_rate>
    </global>
    <resolutions>
        <!-- 16:9 standard -->
        <resolution><width>1920</width><height>1080</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2560</width><height>1440</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>3840</width><height>2160</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1600</width><height>900</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1366</width><height>768</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1280</width><height>720</height><refresh_rate>60</refresh_rate></resolution>

        <!-- 16:10 / 5:3 tablets (Galaxy Tab S, Lenovo Tab, Xiaomi Pad 5/6) -->
        <resolution><width>1280</width><height>800</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1920</width><height>1200</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2560</width><height>1600</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2800</width><height>1752</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2880</width><height>1800</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2960</width><height>1848</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2000</width><height>1200</height><refresh_rate>60</refresh_rate></resolution>

        <!-- 3:2 tablets (Xiaomi Pad 7 / 6S Pro 3200x2136, Surface Pro) -->
        <resolution><width>3200</width><height>2136</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2880</width><height>1920</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2400</width><height>1600</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2160</width><height>1440</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1800</width><height>1200</height><refresh_rate>60</refresh_rate></resolution>

        <!-- 7:5 & 4:3 tablets (OnePlus Pad, ReadMe/iPad sizes) -->
        <resolution><width>2800</width><height>2000</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2408</width><height>1720</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2732</width><height>2048</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2048</width><height>1536</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1024</width><height>768</height><refresh_rate>60</refresh_rate></resolution>

        <!-- 20:9 phones -->
        <resolution><width>2400</width><height>1080</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>3200</width><height>1440</height><refresh_rate>60</refresh_rate></resolution>
    </resolutions>
    <options>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
        <HardwareCursor>true</HardwareCursor>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </options>
</vdd_settings>
