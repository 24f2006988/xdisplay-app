// Windows resources for xdisplay-host.exe: application icon (id 1) and version information.
#include <winver.h>

1 ICON "xdisplay.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "XDisplay contributors"
            VALUE "FileDescription",  "XDisplay - tablet second screen"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "xdisplay-host"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Hrisit Roy. GPL-3.0-or-later."
            VALUE "OriginalFilename", "xdisplay-host.exe"
            VALUE "ProductName",      "XDisplay"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
